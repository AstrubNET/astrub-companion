<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.astrub.companion</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON3__</string>
        <string>/Library/Application Support/Astrub Companion/astrub_companion.py</string>
        <string>--config</string>
        <string>/Library/Application Support/Astrub Companion/config.json</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Library/Logs/AstrubCompanion.log</string>
    <key>StandardErrorPath</key>
    <string>/Library/Logs/AstrubCompanion.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
